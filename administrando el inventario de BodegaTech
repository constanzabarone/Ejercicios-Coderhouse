--Sección DDL

DROP TABLE IF EXISTS inventario;

CREATE TABLE inventario(
id_producto INT PRIMARY KEY,
--le pongo int porque va a ser un número entero, y PK porque va a ser mi llave primaria.
nombre_producto VARCHAR(100),
--uso varchar porque va a contener texto de longitud variable
categoria VARCHAR(50),
--uso VARCHAR(50) porque la categoría contiene texto y limito su longitud a 50 caracteres.
precio_unitario DECIMAL(10,2),
stock_actual INT,
stock_minimo INT,
--utilizo int porque va a tener un numero entero
fecha_ingreso DATE,
activo BIT
-- Uso BIT porque representa dos estados:
-- 1 = disponible y 0 = descontinuado.
);

SELECT * FROM inventario;
--verifico que se haya creado correctamente.

